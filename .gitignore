__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/

# Connectome data. 1.1GB, fetched by scripts/fetch_data.py and pinned by SHA-256.
data/*.feather
cache/
*.npz

# Simulation output
runs/
out/
*.mp4
*.gif

# README media is committed. The rules above are for generated figures and
# screen recordings, which are reproducible from a run; these four are not.
!docs/media/*.gif

# Third-party reference code, fetched for study. Not ours to redistribute.
ref/

# Generated web artifacts. Rebuilt by scripts/export_web.py, export_brain.py
# and the flybody converter; no reason to carry 25MB in the repo.
web/data.json
web/brain.bin
web/brain.json
web/flybody.glb
assets/flybody.glb
data/soma.npz
